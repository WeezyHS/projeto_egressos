// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Egresso {
  id                  Int      @id @default(autoincrement())
  senha               String
  emailPreferencial   String?  @unique
  telefone            String
  cidade              String
  estado              String
  pais                String
  fotoPerfil          String?
  linkedin            String?
  instagram           String?
  visivel             Boolean  @default(true)
  
  // Relacionamentos
  pessoa              Pessoa?  @relation(fields: [pessoaId], references: [id])
  pessoaId            Int?     @unique // Relação 1-para-1
  TrabalhoAtual       TrabalhoAtual[]
}

model TrabalhoAtual {
  id         Int     @id @default(autoincrement())
  empresa    String
  cidade     String
  estado     String
  pais       String
  cargo      String
  anoEntrada Int

  egressoId  Int     @unique
  // Adicionado onDelete: Cascade para que, se um Egresso for deletado, seu trabalho atual também seja.
  egresso    Egresso @relation(fields: [egressoId], references: [id], onDelete: Cascade)
}

model Instituicao {
  id                Int      @id @default(autoincrement())
  fotoPerfil        String?
  nomeCompleto      String
  cnpj              String   @unique
  telefone          String?
  endereco          String?
  cep               String?
  nomeRepresentante String?
  cpfRepresentante  String?
  email             String   @unique
  senha             String

  @@index([cnpj])
}

model Curso {
  id        Int       @id @default(autoincrement())
  nome      String    @unique
  createdAt DateTime  @default(now())

  matriculas Matricula[]
}

enum PessoaStatus {
  ALUNO
  EGRESSO
  OUTRO
}

// --- MODELO PESSOA CORRIGIDO ---
// Objetivo: Pessoa é a "fonte da verdade" para os dados acadêmicos e de identidade.
model Pessoa {
  id        Int      @id @default(autoincrement())
  nome      String
  cpf       String   @unique
  email     String   @unique // Este é o e-mail acadêmico/original
  createdAt DateTime @default(now())
  status    PessoaStatus @default(ALUNO)
  visivel   Boolean  @default(false)

  // --- NOVOS CAMPOS PARA O CONVITE ---
  // Adicionados para armazenar o código de ativação e sua data de expiração.
  codigoConvite     String?
  conviteExpiraEm   DateTime?

  // --- A LIGAÇÃO FUNDAMENTAL (RELAÇÃO 1-PARA-1) ---
  // Cada Pessoa pode ter UM (ou nenhum, por isso o '?') perfil de Egresso associado.
  egresso     Egresso?

  matriculas  Matricula[]
}

model Matricula {
  id                 Int      @id @default(autoincrement())
  cursoId            Int
  pessoaId           Int
  anoSemestreEntrada String
  anoSemestreSaida   String?

  // Adicionado onDelete: Cascade para que, se um Curso ou Pessoa for deletado, a matrícula também seja.
  curso  Curso  @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  pessoa Pessoa @relation(fields: [pessoaId], references: [id], onDelete: Cascade)

  @@unique([cursoId, pessoaId])
}
